rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow all authenticated operations
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    /* ───────────── USER PROFILES ───────────── */
    match /users/{userId} {
      // user can read & write just their own doc
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
      
      // allow read if both users are in the same family
      allow read: if request.auth != null
                  && exists(/databases/$(database)/documents/families/{familyId})
                  && get(/databases/$(database)/documents/families/{familyId}).data.members.hasAll([request.auth.uid, userId]);

      // allow list if user is in any family or was just in a family
      allow list: if request.auth != null
                  && request.query.limit <= 50
                  && (
                      // Allow querying by UID
                      request.query.filters.size() == 1
                      && request.query.filters[0].op == 'in'
                      && request.query.filters[0].path == ['uid']
                      && request.query.filters[0].value is list
                      && request.query.filters[0].value.size() <= 10
                      && (
                          // User is in a family
                          exists(/databases/$(database)/documents/families/{familyId})
                          && get(/databases/$(database)/documents/families/{familyId}).data.members.hasAny([request.auth.uid])
                          ||
                          // User was just in a family (for leave family operation)
                          exists(/databases/$(database)/documents/families/{familyId})
                          && get(/databases/$(database)/documents/families/{familyId}).data.members.hasAny(request.query.filters[0].value)
                      )
                  );
    }

    /* ───────────── FAMILY COLLECTION ───────────── */
    match /families/{familyId} {
      /* anyone logged‑in may read family info */
      allow read: if request.auth != null;

      /* -------- create --------
         – must be logged in
         – must set created_by and owner to their UID
         – must include their UID in both members & admin_roles
      */
      allow create: if request.auth != null
                    && request.resource.data.created_by == request.auth.uid
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.members.hasOnly([request.auth.uid])
                    && request.resource.data.admin_roles.hasOnly([request.auth.uid]);

      /* -------- update --------
         – owner can update anything
         – admins can update everything except:
           - owner field
           - admin_roles field
           - members field (except for removing themselves)
         – members can only update their own status (leave)
      */
      allow update: if request.auth != null
                    && (
                        // Owner can update anything
                        resource.data.owner == request.auth.uid
                        ||
                        // Admins can update most fields except owner and admin_roles
                        resource.data.admin_roles.hasAny([request.auth.uid])
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['owner', 'admin_roles'])
                        && (
                            // Admins can't modify members list except to remove themselves
                            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['members'])
                            || (
                                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                                && request.resource.data.members.hasAll(resource.data.members)
                                && resource.data.members.hasAll([request.auth.uid])
                            )
                        )
                        ||
                        // Members can only leave the family
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                        && request.resource.data.members.hasAll(resource.data.members)
                        && resource.data.members.hasAll([request.auth.uid])
                    );

      /* -------- delete --------
         – only the owner can delete the family
      */
      allow delete: if request.auth != null
                    && resource.data.owner == request.auth.uid;
    }
  }
}
